{
  "uid": "spendly",
  "title": "Spendly API",
  "tags": ["spendly"],
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    {
      "type": "stat", "title": "Requests / second", "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 } },
      "targets": [{ "refId": "A", "expr": "sum(rate(http_requests_total[1m]))" }]
    },
    {
      "type": "stat", "title": "p95 latency", "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3 } },
      "targets": [{ "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))" }]
    },
    {
      "type": "stat", "title": "Error ratio (4xx + 5xx)", "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1,
        "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.1 }, { "color": "red", "value": 0.25 }] } } },
      "targets": [{ "refId": "A", "expr": "sum(rate(http_requests_total{status=~\"4..|5..\"}[5m])) / sum(rate(http_requests_total[5m]))" }]
    },
    {
      "type": "stat", "title": "Records synced / minute", "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } },
      "targets": [{ "refId": "A", "expr": "sum(rate(spendly_sync_records_total[5m])) * 60" }]
    },
    {
      "type": "timeseries", "title": "Requests by route and status", "gridPos": { "x": 0, "y": 4, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [{ "refId": "A", "expr": "sum by (method, route, status) (rate(http_requests_total[1m]))", "legendFormat": "{{method}} {{route}} {{status}}" }]
    },
    {
      "type": "timeseries", "title": "Latency percentiles (/api/sync)", "gridPos": { "x": 12, "y": 4, "w": 12, "h": 9 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/api/sync\"}[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/api/sync\"}[5m])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{route=\"/api/sync\"}[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "type": "timeseries", "title": "Sync records pushed vs pulled", "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [{ "refId": "A", "expr": "sum by (direction) (rate(spendly_sync_records_total[1m])) * 60", "legendFormat": "{{direction}} / min" }]
    },
    {
      "type": "timeseries", "title": "Node.js process", "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" },
        "overrides": [{ "matcher": { "id": "byName", "options": "event loop lag p99" }, "properties": [{ "id": "unit", "value": "s" }, { "id": "custom.axisPlacement", "value": "right" }] }] },
      "targets": [
        { "refId": "A", "expr": "process_resident_memory_bytes", "legendFormat": "resident memory" },
        { "refId": "B", "expr": "nodejs_eventloop_lag_p99_seconds", "legendFormat": "event loop lag p99" }
      ]
    }
  ]
}
